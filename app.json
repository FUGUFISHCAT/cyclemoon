{
  "expo": {
    "name": "月相 Cycle",
    "slug": "cycle",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./public/icons/icon-1024.png",
    "scheme": "yuexiang-cycle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.cyclemoon.personal"
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./public/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5F1",
          "dark": {
            "backgroundColor": "#1D191C"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
