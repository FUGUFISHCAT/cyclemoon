{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "exclude": [
    ".installed-deps",
    ".external-deps-link",
    ".incomplete-node-modules",
    ".incomplete-node-modules-2",
    ".incomplete-node-modules-3",
    "cycle",
    "node_modules",
    "dist",
    "dist-android",
    "dist-ios"
  ],
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
