{
  "name": "yuexiang-cycle",
  "version": "0.4.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:web": "expo export --platform web --output-dir dist && node scripts/build-pwa.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "package:web": "node scripts/package-web.mjs",
    "check:http": "node scripts/check-http.mjs"
  },
  "dependencies": {
    "expo": "58.0.25",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "fake-indexeddb": "6.2.8",
    "typescript": "~6.0.3"
  }
}
